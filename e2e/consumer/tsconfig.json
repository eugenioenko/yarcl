{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@yarcl/config": [
        "./src/yarcl.config.ts",
        "./node_modules/yarcl/src/yarcl.config.ts"
      ]
    }
  },
  "include": ["src", "vite.config.ts"]
}
