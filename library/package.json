{
  "name": "@yarcl/react",
  "version": "0.1.0",
  "description": "Yet another react component library. Your config file is the design system: every key becomes a typed prop and a rendered style.",
  "license": "MIT",
  "author": "Eugene Yakhnenko",
  "homepage": "https://yarcl.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eugenioenko/yarcl.git",
    "directory": "library"
  },
  "bugs": "https://github.com/eugenioenko/yarcl/issues",
  "keywords": [
    "react",
    "component-library",
    "design-system",
    "design-tokens",
    "theming",
    "vite-plugin",
    "typescript"
  ],
  "type": "module",
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./define": "./src/define.ts",
    "./defaults": "./src/yarcl.config.ts",
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./reference": "./src/reference/index.ts",
    "./themes": "./src/themes/index.ts",
    "./css": "./src/apply.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "react": ">=18",
    "vite": ">=5",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "date-fns": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
