{
  "name": "@yarcl/react",
  "version": "0.1.0",
  "description": "Yet another react component library. Your config file is the design system: every key becomes a typed prop and a rendered style.",
  "license": "MIT",
  "author": "Eugene Yakhnenko",
  "homepage": "https://yarcl.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eugenioenko/yarcl.git",
    "directory": "library"
  },
  "bugs": "https://github.com/eugenioenko/yarcl/issues",
  "keywords": [
    "react",
    "component-library",
    "design-system",
    "design-tokens",
    "theming",
    "vite-plugin",
    "typescript"
  ],
  "type": "module",
  "bin": {
    "yarcl": "./dist/cli.js"
  },
  "sideEffects": [
    "./dist/index.js",
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    },
    "./defaults": {
      "types": "./dist/yarcl.config.d.ts",
      "default": "./dist/yarcl.config.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./reference": {
      "types": "./dist/reference/index.d.ts",
      "default": "./dist/reference/index.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "default": "./dist/themes/index.js"
    },
    "./css": {
      "types": "./dist/apply.d.ts",
      "default": "./dist/apply.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "test": "vitest run --config vitest.config.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "vite": ">=6.1"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "date-fns": "^4.4.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1"
  }
}
